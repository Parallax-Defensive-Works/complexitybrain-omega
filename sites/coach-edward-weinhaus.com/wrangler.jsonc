{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coach-edward-weinhaus-com",
  "compatibility_date": "2026-10-01",

  // Assets-only Worker: no script. Cloudflare serves ./public straight from its edge.
  // Requests for static assets are free and do not count against Workers request limits.
  "assets": {
    "directory": "./public",
    // "/page.html" and "/dir/index.html" are served at "/page" and "/dir/" (301 to the clean URL).
    // Use "none" to serve file paths exactly as they are, with no redirects at all.
    "html_handling": "auto-trailing-slash",
    // serves public/404.html for unknown paths, if that file exists
    "not_found_handling": "404-page"
  },

  // The site's hostnames, as Worker routes on the zone. A route takes over a proxied (orange
  // cloud) hostname the moment it is deployed, with no DNS change and no new certificate, so
  // the switch has no downtime. scripts/migrate.sh then points the apex/www DNS records at
  // 192.0.2.1 (proxied) so the old host is out of the path. Deploying this config IS the
  // cutover: see docs/MIGRATION.md. "scripts/deploy.sh <site> --preview" leaves it out.
  "routes": [
    { "pattern": "coach-edward-weinhaus.com/*", "zone_name": "coach-edward-weinhaus.com" },
    { "pattern": "www.coach-edward-weinhaus.com/*", "zone_name": "coach-edward-weinhaus.com" }
  ],

  // No *.workers.dev hostname for the live site (--preview enables it on its own copy).
  "workers_dev": false,
  "preview_urls": false
}
