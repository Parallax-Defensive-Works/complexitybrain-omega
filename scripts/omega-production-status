#!/bin/sh
set -eu
# Omega guarded production status.
# Generated by omega_frontier.ops_scripts. Keep this guard before any raw status or attach path.
OMEGA_PYTHON="${OMEGA_PYTHON:-python3}"
OMEGA_MINIMUM_ELIGIBLE="${OMEGA_MINIMUM_ELIGIBLE:-2}"
: "${OMEGA_CONTROL_DIR:?OMEGA_CONTROL_DIR is required}"
: "${OMEGA_STATE_DIR:?OMEGA_STATE_DIR is required}"
set -- "$OMEGA_PYTHON" -m omega_frontier.cli production-status
set -- "$@" --control-dir "$OMEGA_CONTROL_DIR"
set -- "$@" --state-dir "$OMEGA_STATE_DIR"
set -- "$@" --minimum-eligible "$OMEGA_MINIMUM_ELIGIBLE"
if [ "${OMEGA_BASE_URL:-}" != "" ]; then
  set -- "$@" --base-url "$OMEGA_BASE_URL"
fi
if [ "${OMEGA_ROOT_HTML_FILE:-}" != "" ]; then
  set -- "$@" --html-file "$OMEGA_ROOT_HTML_FILE"
fi
exec "$@"
